# NADOS Dv1.0 Environment Configuration
# Copy this file to .env and modify as needed

# Application
NADOS_APP_NAME="NADOS Dv1.0"
NADOS_APP_VERSION="1.0.0"
NADOS_DEBUG=false
NADOS_LOG_LEVEL=INFO

# Database
NADOS_DB_PATH=data/nados.db
NADOS_DB_ECHO=false

# Simulation
NADOS_DEFAULT_SEED=42
NADOS_MAX_DURATION=3600
NADOS_MAX_OBJECTS=1000
NADOS_MAX_SENSORS=100
NADOS_MAX_OBSERVATIONS=100000
NADOS_MAX_EVENTS=10000

# Visualization
NADOS_2D_ENABLED=true
NADOS_3D_ENABLED=false
NADOS_THEME=dark
NADOS_LANGUAGE=ar

# Logging
NADOS_LOG_DIR=logs
NADOS_LOG_MAX_BYTES=10485760
NADOS_LOG_BACKUP_COUNT=5

# Paths
NADOS_CONFIG_DIR=config
NADOS_SCENARIOS_DIR=scenarios
NADOS_ASSETS_DIR=assets
NADOS_REPORTS_DIR=reports